# ==========================================================
# Backend (FastAPI) — скопируйте в backend/.env и заполните
#   cp backend/.env.example backend/.env
# В Docker часть значений переопределяется docker-compose.yml
# ==========================================================

# --- Обязательные ---
# MongoDB (в Docker переопределяется: mongodb://mongo:27017)
MONGO_URL=mongodb://localhost:27017
DB_NAME=test_database
# Адреса фронтенда через запятую. Только https-адреса попадают в ссылки из писем.
FRONTEND_URL=http://localhost:3000
# Секрет для подписи JWT — придумайте длинную случайную строку
JWT_SECRET=change-me-to-a-long-random-string
# Первичный админ (создаётся при первом старте)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
# Название приложения (используется в путях хранилища файлов и подписи писем)
APP_NAME=donate-mine
EMAIL_FROM_NAME=YanaRPG

# --- Интеграции (без них часть функций отключится) ---
# Письма (сброс пароля) — ключ email-сервиса
EMERGENT_EMAIL_KEY=
# Хранилище файлов (аватары, обложки новостей)
EMERGENT_LLM_KEY=

# --- Платёжные системы (без ключей работает демо-режим, включается в админке) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_ACCOUNT_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_MODE=test
YOOKASSA_SHOP_ID=
FREEKASSA_SHOP_ID=
MONOPAY_TOKEN=
PRIVATPAY_MERCHANT_ID=

# --- Необязательные ---
# Принудительные флаги кук (по умолчанию определяется по схеме запроса: https -> Secure)
# COOKIE_SECURE=true
# Прокси интеграций
# INTEGRATION_PROXY_URL=https://integrations.emergentagent.com
# Обратный адрес в письмах
# EMAIL_REPLY_TO=
